{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1amageek/Xcircuite/ci-artifacts/schemas/hosted-installed-toolchain.schema.json",
  "title": "Hosted Installed Toolchain Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "status", "generatedAt", "profileIdentitySHA256", "realizationIdentitySHA256", "runner", "process", "buildDependencies", "tools", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hosted-installed-toolchain" },
    "status": { "enum": ["passed", "blocked"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "profileIdentitySHA256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "realizationIdentitySHA256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "runner": { "type": "object" },
    "process": { "type": ["object", "null"] },
    "buildDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "sourceRevision", "artifacts"],
        "properties": {
          "repository": { "type": "string", "format": "uri" },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "byteCount"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "byteCount": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repository", "sourceRevision", "executable", "executableSHA256", "executableByteCount", "versionInvocation", "versionOutput", "companions"],
        "properties": {
          "repository": { "type": "string", "format": "uri" },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "executable": { "type": "string" },
          "executableSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "executableByteCount": { "type": "integer", "minimum": 1 },
          "versionInvocation": { "type": "object" },
          "versionOutput": { "type": "string", "minLength": 1 },
          "companions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "executable", "executableSHA256", "executableByteCount", "versionInvocation", "versionOutput"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "executable": { "type": "string", "minLength": 1 },
                "executableSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "executableByteCount": { "type": "integer", "minimum": 1 },
                "versionInvocation": { "type": "object" },
                "versionOutput": { "type": "string", "minLength": 1 }
              }
            }
          },
          "aliasOf": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "reason", "suggestedAction"],
      "properties": {
        "severity": { "const": "error" },
        "code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "suggestedAction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
